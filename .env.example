# העתיקו ל-.env או הגדירו כמשתני סביבה בשירות האירוח
PORT=3000
DATA_DIR=./data              # שם נשמר מסד הנתונים (planner.db). בענן: נפח קבוע (volume)
TRUST_PROXY=1               # רק מאחורי פרוקסי
COOKIE_SECURE=1              # להפעיל תמיד מאחורי HTTPS
ANTHROPIC_API_KEY=           # אופציונלי: מפעיל הערכת קלוריות וחלבון עם AI
AI_MODEL=claude-haiku-4-5-20251001
AI_DAILY_LIMIT=30            # מכסת חישובי AI ליום לכל משתמש
ALLOW_SIGNUP=1               # 0 = סוגר הרשמה לחשבונות חדשים

# שחזור חד-פעמי מגיבוי (ראו docs/DATA-SAFETY.md). להסיר אחרי השימוש:
# RESTORE_FROM=boot-2026-01-01T00-00-00-000Z.db

# מיילים (אימות מייל ושחזור סיסמה). ראו docs/EMAIL.md
# SMTP_URL=smtps://resend:re_XXXX@smtp.resend.com:465
# MAIL_FROM=היום שלי <noreply@example.com>
# BASE_URL=https://dailyplanner.fly.dev
# OPERATOR_NAME=
# CONTACT_EMAIL=
# MAIL_PROVIDER_NAME=Resend
